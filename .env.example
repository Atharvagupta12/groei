# ---- Next.js (.env.local) ----
# Filled in automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public URL of the site (used for social preview links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Convex (set with `npx convex env set NAME value`, NOT in .env.local) ----
# CLERK_JWT_ISSUER_DOMAIN=https://<your-instance>.clerk.accounts.dev
# CLERK_WEBHOOK_SECRET=whsec_...
# DEEPGRAM_API_KEY=...        (required for voice generation)
# CLOUDFLARE_ACCOUNT_ID=...   (optional; Pollinations is used when unset)
# CLOUDFLARE_API_TOKEN=...    (optional)
